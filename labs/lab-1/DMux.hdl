// File name: projects/1/DMux.hdl
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Nand(a=sel , b=sel , out=n1);
    Nand(a=in , b=n1 , out=n2);
    Nand(a=in , b=sel , out=n3);
    Nand(a=n2 , b=n2 , out=a);
    Nand(a=n3 , b=n3 , out=b);

    
    //// Replace this comment with your code.
}