// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Nand(a=sel , b=sel , out=n1 );
    Nand(a=a , b=n1 , out=n2 );
    Nand(a=b , b=sel , out=n3 );
    Nand(a=n2  , b=n3 , out=out );

    //// Replace this comment with your code.
}